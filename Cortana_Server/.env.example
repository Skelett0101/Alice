# US07 - Switch de procesamiento: "cloud" (DeepSeek) o "local"
MODO_IA=cloud
DEEPSEEK_API_KEY=

# Red (Tailscale)
WS_HOST=0.0.0.0
WS_PORT=8765
TAILSCALE_IP=

# Token que el cliente Windows debe presentar para conectarse
TOKEN_CLIENTE=cambia_esto

# API local para que OpenClaw mande órdenes al puente (solo loopback)
LOCAL_API_PORT=8766
